{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "bookmydslradmin": {
      "root": "backend/bookmydslradmin",
      "framework": "django"
    },
    "frontend": {
      "root": "frontend",
      "framework": "nextjs"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": { "service": "frontend" }
    }
  ]
}
