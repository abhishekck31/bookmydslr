{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "bookmydslradmin": {
      "root": "backend/bookmydslradmin",
      "framework": "django"
    },
    "frontend": {
      "root": "frontend",
      "framework": "nextjs",
      "bindings": [
        {
          "type": "service",
          "service": "bookmydslradmin",
          "format": "url",
          "env": "BOOKMYDSLRADMIN_URL"
        }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": { "service": "bookmydslradmin" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "frontend" }
    }
  ]
}
